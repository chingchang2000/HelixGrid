{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixgrid.dev/schema/workflow.schema.json",
  "title": "HelixGrid Workflow Specification",
  "description": "Portable wire contract for dependency-aware HelixGrid workflows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "tasks"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": ".*\\S.*"
    },
    "metadata": {
      "allOf": [
        {
          "$ref": "#/$defs/stringMap"
        },
        {
          "maxProperties": 4096
        }
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": ".*\\S.*"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 1
        },
        "base_delay_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000,
          "default": 250
        },
        "max_delay_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "default": 30000
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "depends_on": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "default": []
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "env": {
          "allOf": [
            {
              "$ref": "#/$defs/stringMap"
            },
            {
              "maxProperties": 4096
            }
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "default": 0
        },
        "retry": {
          "$ref": "#/$defs/retryPolicy"
        },
        "labels": {
          "allOf": [
            {
              "$ref": "#/$defs/stringMap"
            },
            {
              "maxProperties": 128
            }
          ]
        }
      }
    }
  }
}
